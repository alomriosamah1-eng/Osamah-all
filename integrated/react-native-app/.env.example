# ============================================================
# OSAMAH AI AGENT — Thin Client env (Server-First policy)
# ============================================================
# الأسرار (مفاتيح المزوّدات، OpenCode server secrets) تبقى خادمية فقط
# وتُدار في .env الخادم أو Secrets/CI على الخادم — ولا تُحمَّل داخل APK أبداً.
# لا يُقرأ أي مفتاح من بيئة الجهاز/APK في هذا التطبيق.

# عنوان خادم OSAMAH الذي يتصل به التطبيق (الجهاز لا يتصل بمزوّد مباشرة).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
